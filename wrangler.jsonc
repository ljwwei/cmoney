{
  "name": "cmoney-taiex",
  "main": "worker/worker.js",
  "compatibility_date": "2026-11-01",
  // 保留於 Cloudflare Dashboard 設定的環境變數，避免部署時覆蓋既有設定（程式內已預設 IX0001）
  "keep_vars": true,
  // 全站唯一一條富果 WebSocket 連線單例（Free Plan 支援 SQLite-backed Durable Objects）
  "durable_objects": {
    "bindings": [
      {
        "name": "FUGLE_HUB",
        "class_name": "FugleHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FugleHub"]
    }
  ],
  // 獨立 D1 資料庫（累積瀏覽總人次 site_counters 優先讀寫於此）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cmoney-visits",
      "database_id": "7eecf3e4-0592-403a-b4d9-6346d58e3755"
    }
  ]
}
